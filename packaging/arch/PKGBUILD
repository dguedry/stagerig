# Maintainer: Donnie Guedry <dguedry@gmail.com>
#
# StageRig for Arch Linux, from the release's .deb (built on Ubuntu 24.04; it
# needs only libraries with stable sonames and glibc 2.38).
# The release workflow sets pkgver and the checksums, builds it in an Arch
# container with noVNC and websockify (from their AUR recipes), and puts all
# three in StageRig's signed pacman repository beside the apt and dnf ones.

pkgname=stagerig
pkgver=0.1.103
pkgrel=1
pkgdesc='Live-performance plugin host for keyboards and audio'
arch=('x86_64')
url='https://stagerig.org'
license=('GPL-3.0-or-later AND AGPL-3.0-only AND MIT AND ISC AND Apache-2.0 AND BSD-3-Clause AND Zlib AND IJG AND BSD-2-Clause AND BSL-1.0 AND WTFPL AND (Unlicense OR MIT-0)')
options=('!strip' '!debug')
depends=(
  'alsa-lib' 'fontconfig' 'freetype2' 'glibc' 'libgcc' 'libstdc++'
  'libx11' 'libxext' 'libxrandr' 'libxinerama' 'libxcursor' 'libglvnd' 'hicolor-icon-theme'
  # What the .deb recommends, so the tablet, charts and General MIDI work out of the box
  # (novnc and its websockify are built into StageRig's repository; they are not in Arch's)
  'x11vnc' 'novnc' 'xdotool' 'poppler' 'fluidsynth' 'soundfont-fluid'
)
optdepends=(
  'pipewire-jack: low-latency audio through PipeWire (recommended)'
  'jack2: low-latency audio through JACK instead'
  'surge-xt: synthesizer'
  'ob-xf-lv2: Oberheim OB-X synthesizer'
  'setbfree: tonewheel organ with Leslie'
  'dexed: DX7 FM synthesizer'
  'zynaddsubfx: synthesizer'
  'avldrums.lv2: drum kit'
  'dragonfly-reverb: reverbs'
  'lsp-plugins-lv2: effects'
  'x42-plugins-lv2: effects'
  'calf: effects'
  'guitarix: guitar amps and effects'
  'zam-plugins-lv2: effects'
)
_raw="https://raw.githubusercontent.com/dguedry/stagerig/v${pkgver}"
source=("https://github.com/dguedry/stagerig/releases/download/v${pkgver}/stagerig_${pkgver}_amd64.deb"
        "LICENSE-${pkgver}::${_raw}/LICENSE"
        "copyright-${pkgver}::${_raw}/debian/copyright")
noextract=("stagerig_${pkgver}_amd64.deb")
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
  bsdtar -xOf "stagerig_${pkgver}_amd64.deb" 'data.tar.*' | bsdtar -xf - -C "$pkgdir"
  chmod 755 "$pkgdir" "$pkgdir/usr"
  # StageRig's licence, and every bundled library's copyright and licence text
  install -Dm644 "LICENSE-${pkgver}" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "copyright-${pkgver}" "$pkgdir/usr/share/licenses/$pkgname/copyright"
}
